# RepoScope configuration (rename to .env and edit).

# Optional GitHub personal access token (classic or fine-grained, public_repo read is enough).
# Without a token you are limited to 60 GitHub API requests per hour per IP.
# With a token the limit is 5,000 requests per hour.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Server settings
REPOSCOPE_HOST=0.0.0.0
REPOSCOPE_PORT=8000
